{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gemini/analyze",
      "destination": "/api/gemini/analyze"
    },
    {
      "source": "/api/sarvam/transcribe",
      "destination": "/api/sarvam/transcribe"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
